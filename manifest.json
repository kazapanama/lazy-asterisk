{
  "name": "Астеріск для лінивих",
  "version": "0.2",
  "manifest_version": 3,
  "permissions": ["activeTab", "scripting"],	
  "host_permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*/admin/config.php?display=cli*"],
      "css":["style.css"],
      "js": ["utils.js","main.js"]
    }
  ],
  "icons": {
    "128": "/img/tango.png",
    "16": "/img/tango.png"
  }
}